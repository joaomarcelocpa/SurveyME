# Connection string do PostgreSQL (no Render: "External Database URL"), usuario com permissao de INSERT em responses
DATABASE_URL=
# "true" somente depois da entrega do protocolo
SURVEY_OPEN=false
# Opcional: contato exibido no termo de consentimento
NEXT_PUBLIC_CONTACT_EMAIL=
# Opcional: copia secundaria das respostas em uma planilha do Google (ver integrations/google-sheets/README.md)
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
