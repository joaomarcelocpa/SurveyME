# Connection string POOLED do Neon (host com "-pooler"), usuario com permissao de INSERT em responses
DATABASE_URL=
# "true" somente depois da entrega do protocolo
SURVEY_OPEN=false
# Opcional: contato exibido no termo de consentimento
NEXT_PUBLIC_CONTACT_EMAIL=
# Opcional: limite diario por rede com TTL de 24h (Upstash Redis, plano gratuito)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Segredo qualquer longo; torna o hash da rede irreversivel
RATE_LIMIT_SALT=
