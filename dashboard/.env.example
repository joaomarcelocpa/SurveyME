# Copie para dashboard/.env (arquivo ignorado pelo Git). O painel e o backup o leem sozinhos.
# String do usuario SOMENTE LEITURA (survey_ro), nao a do site. Veja docs/operacao.md.
DATABASE_URL_RO=postgresql://survey_ro:SENHA@HOST/neondb?sslmode=require
# "responses" (producao) ou "responses_dev" (dados sinteticos locais)
SURVEY_TABLE=responses
# Alternativa local sem banco: csv:data/seed_dev.csv
# SURVEY_SOURCE=csv:data/seed_dev.csv
# Backup (opcional; padrao ~/survey-backups)
# SURVEY_BACKUP_DIR=
# SURVEY_BACKUP_MIRROR=
